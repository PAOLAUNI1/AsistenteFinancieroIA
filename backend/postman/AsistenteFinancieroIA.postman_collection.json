        {
          "name": "Listar deudas",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/deudas?usuario_id={{usuario_id}}",
              "host": ["{{base_url}}"],
              "path": ["deudas"],
              "query": [{ "key": "usuario_id", "value": "{{usuario_id}}" }]
            }
          }
        },
        {
          "name": "Registrar - Hipotecario",
