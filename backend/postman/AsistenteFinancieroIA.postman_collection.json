{
  "info": {
    "name": "Asistente Financiero Inteligente - API",
    "description": "Colección para probar el backend FastAPI (backend/main.py) del proyecto IA_FINANCIERA, conectado a la base MySQL `asistente_financiero`. Levanta la API con `uvicorn backend.main:app --reload` antes de usarla. Corre primero 'Usuarios > Registrar usuario': guarda el id en la variable de colección `usuario_id`, que usan automáticamente el resto de los requests (no hay login todavía, pero cada endpoint de datos exige indicar de qué usuario se trata).\n\nAutenticación: 'Registrar usuario' o 'Iniciar sesión' guardan el token en la variable de colección `token`; el resto de peticiones lo envían como Bearer.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "usuario_id",
      "value": ""
    },
    {
      "key": "deuda_id",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Registrar usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const cuerpo = pm.response.json();",
                  "    pm.collectionVariables.set('usuario_id', cuerpo.id);",
                  "    pm.collectionVariables.set('token', cuerpo.token);",
                  "}",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Devuelve un token de sesión', () => pm.expect(pm.response.json().token).to.be.a('string').and.not.empty);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/usuarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Camilo Garcia\",\n  \"correo\": \"juancamilo@example.com\",\n  \"contrasena\": \"Segura1234\",\n  \"cantidad_hijos\": 0,\n  \"acepta_terminos\": true,\n  \"acepta_tratamiento_datos\": true\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Iniciar sesión",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const cuerpo = pm.response.json();",
                  "    pm.collectionVariables.set('usuario_id', cuerpo.id);",
                  "    pm.collectionVariables.set('token', cuerpo.token);",
                  "}",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve un token de sesión', () => pm.expect(pm.response.json().token).to.be.a('string').and.not.empty);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/usuarios/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"juancamilo@example.com\",\n  \"contrasena\": \"Segura1234\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Mi usuario (comprueba que la sesión sigue vigente)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/usuarios/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios",
                "me"
              ]
            }
          }
        }
      ]
    },
