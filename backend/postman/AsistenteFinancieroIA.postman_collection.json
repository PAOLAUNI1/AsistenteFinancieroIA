                  "    pm.collectionVariables.set('deuda_id', pm.response.json().id);",
                  "}",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Cuotas pendientes = 219 (ejemplo sección 9 de CLAUDE.md)', () => {",
                  "    pm.expect(pm.response.json().cuotas_pendientes).to.eql(219);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/deudas/hipotecario?usuario_id={{usuario_id}}",
              "host": ["{{base_url}}"],
              "path": ["deudas", "hipotecario"],
