{
  "info": {
    "name": "Asistente Financiero Inteligente - API",
    "description": "Colección para probar el backend FastAPI (backend/main.py) del proyecto IA_FINANCIERA, conectado a la base MySQL `asistente_financiero`. Levanta la API con `uvicorn backend.main:app --reload` antes de usarla. Corre primero 'Usuarios > Registrar usuario': guarda el id en la variable de colección `usuario_id`, que usan automáticamente el resto de los requests (no hay login todavía, pero cada endpoint de datos exige indicar de qué usuario se trata).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "usuario_id", "value": "" },
    { "key": "deuda_id", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Registrar usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('usuario_id', pm.response.json().id);",
                  "}",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/usuarios", "host": ["{{base_url}}"], "path": ["usuarios"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Camilo Garcia\",\n  \"correo\": \"juancamilo@example.com\",\n  \"cantidad_hijos\": 0,\n  \"acepta_terminos\": true,\n  \"acepta_tratamiento_datos\": true\n}"
            }
          }
        },
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/usuarios", "host": ["{{base_url}}"], "path": ["usuarios"] }
          }
        },
        {
          "name": "Obtener usuario por id (chequeo de estado al abrir la app)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/usuarios/{{usuario_id}}",
              "host": ["{{base_url}}"],
              "path": ["usuarios", "{{usuario_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Catálogos",
      "item": [
        {
          "name": "Listar tipos de deuda",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/tipos-deuda", "host": ["{{base_url}}"], "path": ["tipos-deuda"] }
          }
        },
        {
          "name": "Listar categorías de gasto",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/categorias-gasto", "host": ["{{base_url}}"], "path": ["categorias-gasto"] }
          }
        }
      ]
    },
    {
      "name": "Deudas",
