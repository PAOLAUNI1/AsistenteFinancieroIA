# Copia este archivo como `bd.env` (queda fuera de git) y completa tus datos.
# Base de datos MySQL local, para desarrollo:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=asistente_financiero
DB_USER=root
DB_PASSWORD=

# En un servidor en la nube NO se usa este archivo: se definen como variables de entorno
#   DATABASE_URL = mysql://usuario:clave@host:puerto/base   (la entrega el proveedor de MySQL)
#   JWT_SECRET   = un texto largo y aleatorio (firma las sesiones; no la compartas)
# Opcionales: JWT_DIAS (duración de la sesión, 30 por defecto), BCRYPT_ROUNDS (12 por defecto).
